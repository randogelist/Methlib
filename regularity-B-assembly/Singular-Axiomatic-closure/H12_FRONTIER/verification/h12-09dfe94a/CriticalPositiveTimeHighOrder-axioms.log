  0 < ν →
    ∀ (a : CriticalSobolev 1),
      SpectralReality (criticalCoeff 1 a) →
        criticalNonlinearConstant * ‖a‖ < ν →
          ∀ (m : ℕ) (τ T : ℝ),
            0 < τ →
              τ < T →
                ∃ B,
                  0 ≤ B ∧
                    ∀ (N : ℕ) (g : GalerkinSolution ν (finiteSynthesis N (criticalCoeff 1 a)) N),
                      ∀ t ∈ Icc τ T,
                        highOrderEnergy m N (g.coeff t) + ν * ∫ (s : ℝ) in τ..t, highOrderEnergy (m + 1) N (g.coeff s) ≤
                          B
'SingularClosure.SMALL_DATA_POSITIVE_TIME_ALL_ORDERS' depends on axioms: [propext, Classical.choice, Quot.sound]
