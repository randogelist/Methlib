  (∀ (j : ℕ), 1 ≤ j → ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), dyadicAmplitude n ^ 2 = 1 / (↑j ^ 2 * 2 ^ j)) ∧
