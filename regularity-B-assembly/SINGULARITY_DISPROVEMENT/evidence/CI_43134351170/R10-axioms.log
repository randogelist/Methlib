EXACT_TYPE_PASS:SingularityDisprovement.DYADIC_ADMITTED_SCALE
DYADIC_ADMITTED_SCALE : ∀ (ν ε : ℝ),
  0 < ν →
    0 < ε →
      ∃ m,
        1 ≤ m ∧
          0 < ‖(1 / 2) ^ m • dyadicSeed ν‖ ∧
            ‖(1 / 2) ^ m • dyadicSeed ν‖ < ε ∧ calibratedScore ν ((1 / 2) ^ m • dyadicSeed ν) < 1
