import H12_HOLDER_LP_ADAPTER
import Mathlib.MeasureTheory.Integral.Bochner.L1

set_option autoImplicit false

open scoped ENNReal
open MeasureTheory

noncomputable section

namespace NSEPointwisePairingIdentification

open H12CriticalTrilinearCompiler
open H12HolderLpAdapter

/-- Real physical velocity vectors in dimension three. -/
abbrev RVec3 := EuclideanSpace ℝ (Fin 3)

/--
The Jacobian is represented by its induced continuous linear map.
Its norm is the pointwise operator norm.  A later Sobolev adapter may
dominate this by the Frobenius norm.
-/
abbrev Jacobian3 := RVec3 →L[ℝ] RVec3

/-- Pointwise advection generated by a Jacobian and a velocity vector. -/
def advection (J : Jacobian3) (u : RVec3) : RVec3 :=
  J u

/-- Pointwise critical nonlinear pairing. -/
def pointwisePairing
    (J : Jacobian3) (u w : RVec3) : ℝ :=
  inner ℝ (advection J u) w

/-- Operator-norm control of the pointwise advection. -/
theorem advection_norm_le
    (J : Jacobian3) (u : RVec3) :
    ‖advection J u‖ ≤ ‖J‖ * ‖u‖ := by
  exact ContinuousLinearMap.le_opNorm J u

/--
Pointwise NSE pairing estimate:

  |<(u·∇)u,w>| ≤ |u| |∇u|_op |w|.
-/
theorem abs_pointwisePairing_le
    (J : Jacobian3) (u w : RVec3) :
    |pointwisePairing J u w| ≤
      ‖u‖ * ‖J‖ * ‖w‖ := by
  calc
    |pointwisePairing J u w|
        ≤ ‖advection J u‖ * ‖w‖ := by
          exact abs_real_inner_le_norm _ _
    _ ≤ (‖J‖ * ‖u‖) * ‖w‖ := by
          exact mul_le_mul_of_nonneg_right
            (advection_norm_le J u)
            (norm_nonneg w)
    _ = ‖u‖ * ‖J‖ * ‖w‖ := by ring

/-- The pointwise estimate holds everywhere, hence almost everywhere. -/
theorem abs_pointwisePairing_ae
    {α : Type*} [MeasurableSpace α]
    (μ : Measure α)
    (J : α → Jacobian3)
    (u w : α → RVec3) :
    ∀ᵐ x ∂μ,
      |pointwisePairing (J x) (u x) (w x)| ≤
        ‖u x‖ * ‖J x‖ * ‖w x‖ := by
  exact Filter.Eventually.of_forall
    (fun x => abs_pointwisePairing_le (J x) (u x) (w x))

/--
Exact norm-level realization of the physical NSE pairing.

`q` is the `L¹` representative of the actual scalar nonlinear pairing.
The field `pointwiseLift` is the norm-level lift of the pointwise estimate
into the already A-tier three-factor Hölder product.  It is kept explicit:
the theorem does not hide a measurable-selection or exponent-cast premise.
-/
structure NSEPairingRealization
    {α : Type*} [MeasurableSpace α]
    (μ : Measure α)
    (s : CriticalState) where
  f : Lp ℝ 3 μ
  g : Lp ℝ 3 μ
  h : Lp ℝ 3 μ
  q : Lp ℝ 1 μ
  U3_eq : s.U3 = ‖f‖
  G3_eq : s.G3 = ‖g‖
  L3_eq : s.L3 = ‖h‖
  Iabs_eq :
    s.Iabs = ‖MeasureTheory.L1.integral q‖
  pointwiseLift :
    ‖q‖ ≤ ‖tripleProduct μ f g h‖

/--
The actual integral pairing is dominated by the canonical Hölder product.
-/
theorem integral_pairing_dominated
    {α : Type*} [MeasurableSpace α]
    {μ : Measure α}
    {s : CriticalState}
    (R : NSEPairingRealization μ s) :
    s.Iabs ≤ ‖tripleProduct μ R.f R.g R.h‖ := by
  rw [R.Iabs_eq]
  exact (MeasureTheory.L1.norm_integral_le R.q).trans
    R.pointwiseLift

/--
Convert the physical integral realization into the already audited generic
critical-pairing realization.
-/
def toCriticalPairingRealization
    {α : Type*} [MeasurableSpace α]
    {μ : Measure α}
    {s : CriticalState}
    (R : NSEPairingRealization μ s) :
    CriticalPairingRealization μ s where
  f := R.f
  g := R.g
  h := R.h
  U3_eq := R.U3_eq
  G3_eq := R.G3_eq
  L3_eq := R.L3_eq
  pairingDominated := integral_pairing_dominated R

/--
The physical integral realization discharges `CriticalHolder`.
-/
theorem criticalHolder_of_nsePairing
    {α : Type*} [MeasurableSpace α]
    {μ : Measure α}
    {s : CriticalState}
    (R : NSEPairingRealization μ s) :
    CriticalHolder s := by
  exact criticalHolder_of_realization
    (toCriticalPairingRealization R)

/--
Composition with the periodic critical Sobolev endpoint.
-/
theorem critical_trilinear_of_nsePairing
    {α : Type*} [MeasurableSpace α]
    {μ : Measure α}
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (R : NSEPairingRealization μ s) :
    s.Iabs ≤ criticalConstant hS * s.E * s.D ^ 2 := by
  exact critical_trilinear s hS
    (criticalHolder_of_nsePairing R)

/--
Composition with the already audited critical absorption radius.
-/
theorem critical_trilinear_absorbed_of_nsePairing
    {α : Type*} [MeasurableSpace α]
    {μ : Measure α}
    {ν : ℝ}
    (hν : 0 < ν)
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (R : NSEPairingRealization μ s)
    (hsmall :
      s.E ≤ H12CriticalAbsorption.criticalRadius ν
        (criticalConstant hS)) :
    s.Iabs ≤ (ν / 4) * s.D ^ 2 := by
  exact critical_trilinear_absorbed hν s hS
    (criticalHolder_of_nsePairing R)
    hsmall

/--
Audited root.

It certifies the exact implication from an explicit physical integral
realization to the abstract `CriticalHolder` endpoint.
-/
theorem NSE_POINTWISE_PAIRING_IDENTIFICATION :
    ∀ {α : Type*} [MeasurableSpace α]
      {μ : Measure α}
      {s : CriticalState},
      NSEPairingRealization μ s →
      CriticalHolder s := by
  intro α inst μ s R
  exact criticalHolder_of_nsePairing R

end NSEPointwisePairingIdentification
