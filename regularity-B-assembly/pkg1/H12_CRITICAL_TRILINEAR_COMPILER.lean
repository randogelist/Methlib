import H12_CRITICAL_ABSORPTION

set_option autoImplicit false

noncomputable section

namespace H12CriticalTrilinearCompiler

open H12CriticalAbsorption

/--
Scalar norm state extracted from one periodic critical NSE time-slice.

`E` is the H^(1/2) norm,
`D` is the H^(3/2) norm,
`U3` is the L^3 norm of u,
`G3` is the L^3 norm of grad u,
`L3` is the L^3 norm of Lambda u,
`Iabs` is the absolute critical nonlinear pairing.
-/
structure CriticalState where
  E : ℝ
  D : ℝ
  U3 : ℝ
  G3 : ℝ
  L3 : ℝ
  Iabs : ℝ
  E_nonneg : 0 ≤ E
  D_nonneg : 0 ≤ D
  U3_nonneg : 0 ≤ U3
  G3_nonneg : 0 ≤ G3
  L3_nonneg : 0 ≤ L3
  Iabs_nonneg : 0 ≤ Iabs

/--
Exact analytic endpoint interface needed from periodic H^(1/2)->L^3.

The same constant `C3` controls the three Sobolev instances used in the
critical trilinear estimate.
-/
structure PeriodicHhalfL3 (s : CriticalState) where
  C3 : ℝ
  C3_pos : 0 < C3
  velocity :
    s.U3 ≤ C3 * s.E
  gradient :
    s.G3 ≤ C3 * s.D
  lambda :
    s.L3 ≤ C3 * s.D

/-- Hölder endpoint for the critical nonlinear pairing. -/
def CriticalHolder (s : CriticalState) : Prop :=
  s.Iabs ≤ s.U3 * s.G3 * s.L3

/-- Critical cubic constant generated by one periodic Sobolev constant. -/
def criticalConstant {s : CriticalState} (hS : PeriodicHhalfL3 s) : ℝ :=
  hS.C3 ^ 3

theorem criticalConstant_pos
    {s : CriticalState} (hS : PeriodicHhalfL3 s) :
    0 < criticalConstant hS := by
  unfold criticalConstant
  exact pow_pos hS.C3_pos 3

/--
The exact critical trilinear compiler:

  |I| <= ||u||_3 ||grad u||_3 ||Lambda u||_3
      <= C3^3 E D^2.
-/
theorem critical_trilinear
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (hH : CriticalHolder s) :
    s.Iabs ≤ criticalConstant hS * s.E * s.D ^ 2 := by
  have hUG :
      s.U3 * s.G3 ≤
        (hS.C3 * s.E) * (hS.C3 * s.D) := by
    exact mul_le_mul hS.velocity hS.gradient
      s.G3_nonneg
      (mul_nonneg hS.C3_pos.le s.E_nonneg)
  have hUGL :
      s.U3 * s.G3 * s.L3 ≤
        ((hS.C3 * s.E) * (hS.C3 * s.D)) *
          (hS.C3 * s.D) := by
    exact mul_le_mul hUG hS.lambda
      s.L3_nonneg
      (mul_nonneg
        (mul_nonneg hS.C3_pos.le s.E_nonneg)
        (mul_nonneg hS.C3_pos.le s.D_nonneg))
  calc
    s.Iabs ≤ s.U3 * s.G3 * s.L3 := hH
    _ ≤ ((hS.C3 * s.E) * (hS.C3 * s.D)) *
          (hS.C3 * s.D) := hUGL
    _ = criticalConstant hS * s.E * s.D ^ 2 := by
      unfold criticalConstant
      ring

/--
The trilinear estimate is absorbed by viscosity whenever the H^(1/2) norm
lies in the already A-tier critical radius.
-/
theorem critical_trilinear_absorbed
    {ν : ℝ}
    (hν : 0 < ν)
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (hH : CriticalHolder s)
    (hsmall :
      s.E ≤ criticalRadius ν (criticalConstant hS)) :
    s.Iabs ≤ (ν / 4) * s.D ^ 2 := by
  have htri := critical_trilinear s hS hH
  have habs :=
    critical_nonlinearity_absorbed
      hν
      (criticalConstant_pos hS)
      s.E_nonneg
      s.D_nonneg
      hsmall
  exact htri.trans habs

/--
Full scalar critical-energy closure.

If the PDE energy identity supplies

  L + ν D^2 <= Iabs,

then the periodic endpoint + Hölder + critical smallness imply

  L + 3ν/4 D^2 <= 0.
-/
theorem critical_energy_absorbed
    {ν L : ℝ}
    (hν : 0 < ν)
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (hH : CriticalHolder s)
    (hsmall :
      s.E ≤ criticalRadius ν (criticalConstant hS))
    (henergy :
      L + ν * s.D ^ 2 ≤ s.Iabs) :
    L + (3 * ν / 4) * s.D ^ 2 ≤ 0 := by
  have htri := critical_trilinear s hS hH
  have henergy' :
      L + ν * s.D ^ 2 ≤
        criticalConstant hS * s.E * s.D ^ 2 :=
    henergy.trans htri
  exact absorbed_energy_inequality
    hν
    (criticalConstant_pos hS)
    s.E_nonneg
    s.D_nonneg
    hsmall
    henergy'

/-- Consequently the critical energy derivative term is nonpositive. -/
theorem critical_energy_term_nonpositive
    {ν L : ℝ}
    (hν : 0 < ν)
    (s : CriticalState)
    (hS : PeriodicHhalfL3 s)
    (hH : CriticalHolder s)
    (hsmall :
      s.E ≤ criticalRadius ν (criticalConstant hS))
    (henergy :
      L + ν * s.D ^ 2 ≤ s.Iabs) :
    L ≤ 0 := by
  have h :=
    critical_energy_absorbed hν s hS hH hsmall henergy
  have hcoef : 0 ≤ 3 * ν / 4 := by
    nlinarith
  have hdiss : 0 ≤ (3 * ν / 4) * s.D ^ 2 :=
    mul_nonneg hcoef (sq_nonneg s.D)
  linarith

/--
Audited conditional compiler.  It proves the exact implication from the named
periodic endpoint and Hölder premise to the critical trilinear and absorbed
energy conclusions.
-/
structure CriticalTrilinearCompilerBundle : Prop where
  trilinear :
    ∀ (s : CriticalState)
      (hS : PeriodicHhalfL3 s),
      CriticalHolder s →
      s.Iabs ≤ criticalConstant hS * s.E * s.D ^ 2
  absorbed :
    ∀ {ν : ℝ}, 0 < ν →
      ∀ (s : CriticalState)
      (hS : PeriodicHhalfL3 s),
      CriticalHolder s →
      s.E ≤ criticalRadius ν (criticalConstant hS) →
      s.Iabs ≤ (ν / 4) * s.D ^ 2
  energy :
    ∀ {ν L : ℝ}, 0 < ν →
      ∀ (s : CriticalState)
      (hS : PeriodicHhalfL3 s),
      CriticalHolder s →
      s.E ≤ criticalRadius ν (criticalConstant hS) →
      L + ν * s.D ^ 2 ≤ s.Iabs →
      L + (3 * ν / 4) * s.D ^ 2 ≤ 0

theorem H12_CRITICAL_TRILINEAR_COMPILER :
    CriticalTrilinearCompilerBundle :=
  ⟨critical_trilinear,
    critical_trilinear_absorbed,
    critical_energy_absorbed⟩

end H12CriticalTrilinearCompiler
