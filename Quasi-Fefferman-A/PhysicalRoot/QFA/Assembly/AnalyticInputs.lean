import QFA.Endpoints.Agmon.Contracts
import QFA.Endpoints.Agmon.Scalar
import QFA.Endpoints.Representation.Complexification

/-!
# QFA: actual field estimates to nonlinear absorption

Status: A_TIER_CANDIDATE. No local Lean or Lake execution.
External baseline: Lean 4.33.0 and Mathlib
db584cd6d46c92f209a44c0f1c829460d327499d.

Derivation locations: D06.06--D06.08 -> D07.01.
Existing local inputs: LE015--LE025, LE044--LE046, LC002 and LC003.

The energies below are the actual full-volume spatial L2 norm readouts.
The gradient readout is a sum of three squared directional norms.

LC002 and LC003 remain explicit analytic hypotheses. The supplied Schwartz
derivative witnesses and convection estimate remain explicit as well. This
module does not construct these analytic inputs or an NSE identity. The
number `d` is a supplied derivative value, without a derivative-existence
claim. A positive scalar absorption margin is not a PDE continuation theorem.
-/

set_option autoImplicit false
set_option Elab.async true

open MeasureTheory
open scoped BigOperators BoundedContinuousFunction

namespace QFA.Assembly.AnalyticInputs

open QFA.Endpoints.Agmon
open QFA.Endpoints.Representation

noncomputable section

/-- Assemble the scalar profile from actual field norms and three supplied
analytic inequalities. Positivity of every norm readout is derived.

This helper uses the norm of `V`; its a.e. representative relation is retained
explicitly by `exists_scalarProfile_of_analytic_endpoints` below.
-/
theorem scalarProfile_of_field_estimates
    {v L : ComplexL2} {G : Fin 3 → ComplexL2}
    {V : Space →ᵇ ComplexVector} {N : ℝ}
    (hN : 0 ≤ N)
    (hInterpolation : gradientEnergy G ^ 2 ≤ velocityEnergy v * laplacianEnergy L)
    (hAgmon : ‖V‖ ^ 2 ≤
      Real.sqrt (gradientEnergy G * laplacianEnergy L) / (2 * Real.pi))
    (hConvection : N ≤ ‖V‖ * Real.sqrt (gradientEnergy G) *
      Real.sqrt (laplacianEnergy L)) :
    ScalarProfile (velocityEnergy v) (gradientEnergy G) (laplacianEnergy L) ‖V‖ N := by
  refine
    { energy_nonneg := ?_
      gradient_nonneg := ?_
      laplacian_nonneg := ?_
      amplitude_nonneg := norm_nonneg V
      nonlinear_nonneg := hN
      interpolation := hInterpolation
      agmon := hAgmon
      convection := hConvection }
  · exact sq_nonneg ‖v‖
  · unfold gradientEnergy
    exact Finset.sum_nonneg (fun j _ => sq_nonneg ‖G j‖)
  · exact sq_nonneg ‖L‖

/-- The same field-to-scalar assembly for real spatial L2 data. Existing
complexification identities preserve all three energies exactly.

The supplied fields `G` and `L` require independent derivative identification.
No new gradient or Laplacian witness is generated by this implication.
-/
theorem scalarProfile_of_complexified_field_estimates
    {v L : RealL2} {G : Fin 3 → RealL2}
    {V : Space →ᵇ ComplexVector} {N : ℝ}
    (hN : 0 ≤ N)
    (hInterpolation : (∑ j : Fin 3, ‖G j‖ ^ 2) ^ 2 ≤ ‖v‖ ^ 2 * ‖L‖ ^ 2)
    (hAgmon : ‖V‖ ^ 2 ≤
      Real.sqrt ((∑ j : Fin 3, ‖G j‖ ^ 2) * ‖L‖ ^ 2) / (2 * Real.pi))
    (hConvection : N ≤ ‖V‖ * Real.sqrt (∑ j : Fin 3, ‖G j‖ ^ 2) *
      Real.sqrt (‖L‖ ^ 2)) :
    ScalarProfile (‖v‖ ^ 2) (∑ j : Fin 3, ‖G j‖ ^ 2) (‖L‖ ^ 2) ‖V‖ N := by
  have hProfile : ScalarProfile (velocityEnergy (complexifyL2 v))
      (gradientEnergy (fun j => complexifyL2 (G j)))
      (laplacianEnergy (complexifyL2 L)) ‖V‖ N :=
    scalarProfile_of_field_estimates
      (v := complexifyL2 v) (G := fun j => complexifyL2 (G j))
      (L := complexifyL2 L) (V := V) hN
      (by simpa only [complexifyL2_velocityEnergy, complexifyL2_gradientEnergy,
          complexifyL2_laplacianEnergy] using hInterpolation)
      (by simpa only [complexifyL2_gradientEnergy, complexifyL2_laplacianEnergy]
          using hAgmon)
      (by simpa only [complexifyL2_gradientEnergy, complexifyL2_laplacianEnergy]
          using hConvection)
  simpa only [complexifyL2_velocityEnergy, complexifyL2_gradientEnergy,
    complexifyL2_laplacianEnergy] using hProfile

/-- LC002 and LC003 supply the two analytic norm inequalities and a bounded
continuous representative. The convection premise applies to that actual
representative. Its a.e. relation is retained in the output.

The analytic endpoints are arguments, not new axiom declarations or proved
inhabitants of the pending proposition targets.
-/
theorem exists_scalarProfile_of_analytic_endpoints
    (hInterpolation : WholeSpaceInterpolationEndpoint)
    (hAgmon : WholeSpaceAgmonEndpoint)
    {v L : ComplexL2} {G : Fin 3 → ComplexL2} {N : ℝ}
    (hDerivatives : SchwartzDerivativeWitnesses v G L)
    (hN : 0 ≤ N)
    (hConvection : ∀ V : Space →ᵇ ComplexVector,
      (fun x : Space => V x) =ᵐ[volume] (fun x : Space => v x) →
        N ≤ ‖V‖ * Real.sqrt (gradientEnergy G) * Real.sqrt (laplacianEnergy L)) :
    ∃ V : Space →ᵇ ComplexVector,
      (fun x : Space => V x) =ᵐ[volume] (fun x : Space => v x) ∧
        ScalarProfile (velocityEnergy v) (gradientEnergy G) (laplacianEnergy L) ‖V‖ N := by
  obtain ⟨V, hV, hBound⟩ := hAgmon v G L hDerivatives
  exact ⟨V, hV, scalarProfile_of_field_estimates hN
    (hInterpolation v G L hDerivatives) hBound (hConvection V hV)⟩

/-- Deterministic use of the analytic inputs followed by LE017 and LE021.
All zero-energy cases are retained; no division by a field energy occurs.
-/
theorem nonlinear_estimates_of_analytic_endpoints
    (hInterpolation : WholeSpaceInterpolationEndpoint)
    (hAgmon : WholeSpaceAgmonEndpoint)
    {v L : ComplexL2} {G : Fin 3 → ComplexL2} {N : ℝ}
    (hDerivatives : SchwartzDerivativeWitnesses v G L)
    (hN : 0 ≤ N)
    (hConvection : ∀ V : Space →ᵇ ComplexVector,
      (fun x : Space => V x) =ᵐ[volume] (fun x : Space => v x) →
        N ≤ ‖V‖ * Real.sqrt (gradientEnergy G) * Real.sqrt (laplacianEnergy L)) :
    4 * Real.pi ^ 2 * N ^ 4 ≤
        (velocityEnergy v * gradientEnergy G) * laplacianEnergy L ^ 4 ∧
      N ≤ nonlinearCoefficient (velocityEnergy v) (gradientEnergy G) * laplacianEnergy L := by
  obtain ⟨V, _, hProfile⟩ := exists_scalarProfile_of_analytic_endpoints
    hInterpolation hAgmon hDerivatives hN hConvection
  exact ⟨hProfile.nonlinear_fourth_power, hProfile.nonlinear_le_coefficient⟩

/-- A supplied enstrophy inequality and strict energy-product threshold give
an explicit positive absorption margin. The exact coefficient is retained.

The declaration proves the implication from its analytic and derivative-value
premises. It does not establish their physical realization or continuation.
-/
theorem exists_positive_margin_of_analytic_endpoints
    (hInterpolation : WholeSpaceInterpolationEndpoint)
    (hAgmon : WholeSpaceAgmonEndpoint)
    {v L : ComplexL2} {G : Fin 3 → ComplexL2} {N d ν : ℝ}
    (hDerivatives : SchwartzDerivativeWitnesses v G L)
    (hN : 0 ≤ N)
    (hConvection : ∀ V : Space →ᵇ ComplexVector,
      (fun x : Space => V x) =ᵐ[volume] (fun x : Space => v x) →
        N ≤ ‖V‖ * Real.sqrt (gradientEnergy G) * Real.sqrt (laplacianEnergy L))
    (hν : 0 < ν)
    (hSmall : velocityEnergy v * gradientEnergy G < 4 * Real.pi ^ 2 * ν ^ 4)
    (hEnstrophy : d / 2 + ν * laplacianEnergy L ≤ N) :
    ∃ η : ℝ,
      η = ν - nonlinearCoefficient (velocityEnergy v) (gradientEnergy G) ∧
      0 < η ∧
      N ≤ (ν - η) * laplacianEnergy L ∧
      d + 2 * η * laplacianEnergy L ≤ 0 := by
  obtain ⟨V, _, hProfile⟩ := exists_scalarProfile_of_analytic_endpoints
    hInterpolation hAgmon hDerivatives hN hConvection
  refine ⟨ν - nonlinearCoefficient (velocityEnergy v) (gradientEnergy G),
    rfl, hProfile.viscosity_margin_pos hν hSmall, ?_,
    hProfile.enstrophy_absorption hEnstrophy⟩
  have hCoefficient : ν - (ν - nonlinearCoefficient (velocityEnergy v) (gradientEnergy G)) =
      nonlinearCoefficient (velocityEnergy v) (gradientEnergy G) := by ring
  simpa only [hCoefficient] using hProfile.nonlinear_le_coefficient

end

end QFA.Assembly.AnalyticInputs
