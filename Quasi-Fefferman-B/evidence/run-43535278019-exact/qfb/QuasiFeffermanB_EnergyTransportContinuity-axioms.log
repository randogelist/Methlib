TYPE_BEGIN:QuasiFeffermanB.energyWeakTransport_eq_L2_inner
QuasiFeffermanB.energyWeakTransport_eq_L2_inner : ∀ (v φ : SingularClosure.Field)
  (hv : MeasureTheory.MemLp v 2 (MeasureTheory.volume.restrict SingularClosure.unitCube)) (hφ : ContDiff ℝ (↑⊤) φ),
  SingularClosure.criticalWeakTransport v φ =
