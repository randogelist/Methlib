TYPE_BEGIN:QuasiFeffermanB.energyWeakTransport_L2_tendsto
@QuasiFeffermanB.energyWeakTransport_L2_tendsto : ∀ {ι : Type u_1} {l : Filter ι}
  (v : ι → ↥SingularClosure.PhysicalCubeL2) (w : ↥SingularClosure.PhysicalCubeL2),
  Filter.Tendsto v l (nhds w) →
    ∀ (φ : SingularClosure.Field),
      ContDiff ℝ (↑⊤) φ →
        Filter.Tendsto (fun n => SingularClosure.criticalWeakTransport (↑↑(v n)) φ) l
          (nhds (SingularClosure.criticalWeakTransport (↑↑w) φ))
