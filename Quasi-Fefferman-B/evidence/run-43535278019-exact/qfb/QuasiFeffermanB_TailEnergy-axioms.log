TYPE_BEGIN:QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_REFERENCE
@QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_REFERENCE : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  0 < ν →
    SingularClosure.CriticalLerayHopf ν a u G →
      ∀ {v : SingularClosure.Velocity} {p : SingularClosure.Pressure},
        SingularClosure.PositiveSmoothNSE ν v p →
          ∀ {s δ : ℝ},
            0 ≤ s →
              s < δ →
                (∀ (r : ℝ), s < r → u r =ᵐ[MeasureTheory.volume.restrict SingularClosure.unitCube] v (r - s)) →
                  QuasiFeffermanB.TailEnergyEquality ν u G δ
TYPE_END:QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_REFERENCE
'QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_REFERENCE' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_FLOW
@QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_FLOW : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  0 < ν →
    SingularClosure.CriticalLerayHopf ν a u G →
      ∀ (L : SingularClosure.CriticalPositiveSobolevFlow ν) {s δ : ℝ},
        0 ≤ s →
          s < δ →
            (∀ (r : ℝ), s < r → u r =ᵐ[MeasureTheory.volume.restrict SingularClosure.unitCube] L.velocity (r - s)) →
              QuasiFeffermanB.TailEnergyEquality ν u G δ
TYPE_END:QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_FLOW
'QuasiFeffermanB.LH_TAIL_ENERGY_OF_POSITIVE_FLOW' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.LH_RESTART_OF_TAIL_ENERGY
@QuasiFeffermanB.LH_RESTART_OF_TAIL_ENERGY : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  0 ≤ ν →
    SingularClosure.CriticalLerayHopf ν a u G →
      ∀ {δ : ℝ},
        0 ≤ δ →
          QuasiFeffermanB.TailEnergyEquality ν u G δ →
            SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative (u δ))
              (QuasiFeffermanB.Shift δ u) fun t => G (δ + t)
TYPE_END:QuasiFeffermanB.LH_RESTART_OF_TAIL_ENERGY
'QuasiFeffermanB.LH_RESTART_OF_TAIL_ENERGY' depends on axioms: [propext, Classical.choice, Quot.sound]
