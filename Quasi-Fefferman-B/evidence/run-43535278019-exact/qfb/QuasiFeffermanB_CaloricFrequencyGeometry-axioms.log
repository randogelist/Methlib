TYPE_BEGIN:QuasiFeffermanB.frequencyRadius_pos
QuasiFeffermanB.frequencyRadius_pos : ∀ (k : SingularClosure.Frequency), k ≠ 0 → 0 < QuasiFeffermanB.frequencyRadius k
TYPE_END:QuasiFeffermanB.frequencyRadius_pos
'QuasiFeffermanB.frequencyRadius_pos' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.frequencyRadius_sq
QuasiFeffermanB.frequencyRadius_sq : ∀ (k : SingularClosure.Frequency),
  QuasiFeffermanB.frequencyRadius k ^ 2 = ↑(SingularClosure.galerkinFreqSq k)
TYPE_END:QuasiFeffermanB.frequencyRadius_sq
'QuasiFeffermanB.frequencyRadius_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.complexFrequency_norm_sq
QuasiFeffermanB.complexFrequency_norm_sq : ∀ (k : SingularClosure.Frequency),
  ‖QuasiFeffermanB.complexFrequency k‖ ^ 2 = ↑(SingularClosure.galerkinFreqSq k)
TYPE_END:QuasiFeffermanB.complexFrequency_norm_sq
'QuasiFeffermanB.complexFrequency_norm_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.complexFrequency_norm
QuasiFeffermanB.complexFrequency_norm : ∀ (k : SingularClosure.Frequency),
  ‖QuasiFeffermanB.complexFrequency k‖ = QuasiFeffermanB.frequencyRadius k
TYPE_END:QuasiFeffermanB.complexFrequency_norm
'QuasiFeffermanB.complexFrequency_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.normalizedComplexFrequency_norm
QuasiFeffermanB.normalizedComplexFrequency_norm : ∀ (k : SingularClosure.Frequency),
  k ≠ 0 → ‖QuasiFeffermanB.normalizedComplexFrequency k‖ = 1
TYPE_END:QuasiFeffermanB.normalizedComplexFrequency_norm
'QuasiFeffermanB.normalizedComplexFrequency_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.complexFrequency_inner
QuasiFeffermanB.complexFrequency_inner : ∀ (k : SingularClosure.Frequency) (z : Fin 3 → ℂ),
  inner ℂ (QuasiFeffermanB.complexFrequency k) (QuasiFeffermanB.complexVec z) = QuasiFeffermanB.frequencyDot k z
TYPE_END:QuasiFeffermanB.complexFrequency_inner
'QuasiFeffermanB.complexFrequency_inner' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.normalizedComplexFrequency_inner
QuasiFeffermanB.normalizedComplexFrequency_inner : ∀ (k : SingularClosure.Frequency) (z : Fin 3 → ℂ),
  inner ℂ (QuasiFeffermanB.normalizedComplexFrequency k) (QuasiFeffermanB.complexVec z) =
    (↑(QuasiFeffermanB.frequencyRadius k))⁻¹ * QuasiFeffermanB.frequencyDot k z
TYPE_END:QuasiFeffermanB.normalizedComplexFrequency_inner
'QuasiFeffermanB.normalizedComplexFrequency_inner' depends on axioms: [propext, Classical.choice, Quot.sound]
