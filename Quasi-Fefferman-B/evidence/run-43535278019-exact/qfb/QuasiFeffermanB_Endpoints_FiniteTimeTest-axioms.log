TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_PAIRING_HASDERIV
@QuasiFeffermanB.ENERGY_GALERKIN_PAIRING_HASDERIV : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (t : ℝ),
      0 < t →
        HasDerivAt (fun r => SingularClosure.physicalFieldInner (g.velocity r) (φ r))
          (SingularClosure.physicalFieldInner (g.velocity t) (SingularClosure.timeDerivative φ t) +
            SingularClosure.physicalFieldInner (SingularClosure.timeDerivative g.velocity t) (φ t))
          t
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_PAIRING_HASDERIV
'QuasiFeffermanB.ENERGY_GALERKIN_PAIRING_HASDERIV' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.energy_finite_projection_pairing
QuasiFeffermanB.energy_finite_projection_pairing : ∀ (N : ℕ) (c : SingularClosure.FourierCoeff)
  (f : SingularClosure.Field),
  Continuous f →
    SingularClosure.physicalFieldInner (SingularClosure.finiteSynthesis N c)
        (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff f)) =
      SingularClosure.physicalFieldInner (SingularClosure.finiteSynthesis N c) f
TYPE_END:QuasiFeffermanB.energy_finite_projection_pairing
'QuasiFeffermanB.energy_finite_projection_pairing' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.energy_test_projection_laplacian
QuasiFeffermanB.energy_test_projection_laplacian : ∀ (N : ℕ) (f : SingularClosure.Field),
  ContDiff ℝ (↑⊤) f →
    SingularClosure.SpatialPeriodic f →
      SingularClosure.laplacian (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff f)) =
        SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff (SingularClosure.laplacian f))
TYPE_END:QuasiFeffermanB.energy_test_projection_laplacian
'QuasiFeffermanB.energy_test_projection_laplacian' depends on axioms: [propext, Classical.choice, Quot.sound]
