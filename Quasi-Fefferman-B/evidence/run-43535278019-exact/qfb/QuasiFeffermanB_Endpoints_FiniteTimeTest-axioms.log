  (I : Set ℝ),
  (∀ (k : SingularClosure.Frequency) (i : Fin 3), ContinuousOn (fun r => c r k i) I) →
    ∀ (k : SingularClosure.Frequency) (i : Fin 3), ContinuousOn (fun r => SingularClosure.galerkinRhs ν N (c r) k i) I
