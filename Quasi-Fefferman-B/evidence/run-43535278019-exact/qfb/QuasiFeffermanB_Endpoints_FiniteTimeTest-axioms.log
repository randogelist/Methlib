QuasiFeffermanB.energyTest_fourier_solenoidal : ∀ (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (t : ℝ), 0 < t → SingularClosure.SpectralSolenoidal (SingularClosure.datumFourierCoeff (φ t))
TYPE_END:QuasiFeffermanB.energyTest_fourier_solenoidal
'QuasiFeffermanB.energyTest_fourier_solenoidal' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.energyGalerkin_projected_test_pairing
@QuasiFeffermanB.energyGalerkin_projected_test_pairing : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (t : ℝ),
      0 < t →
        SingularClosure.physicalFieldInner (SingularClosure.timeDerivative g.velocity t) (φ t) =
          ν * SingularClosure.physicalFieldInner (g.velocity t) (SingularClosure.laplacian (φ t)) +
            SingularClosure.criticalWeakTransport (g.velocity t)
              (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff (φ t)))
TYPE_END:QuasiFeffermanB.energyGalerkin_projected_test_pairing
'QuasiFeffermanB.energyGalerkin_projected_test_pairing' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE
@QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (s t : ℝ),
      0 < s →
        s ≤ t →
          IntervalIntegrable
              (fun r => SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.timeDerivative φ r))
              MeasureTheory.volume s t ∧
            IntervalIntegrable
                (fun r => SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.laplacian (φ r)))
                MeasureTheory.volume s t ∧
              IntervalIntegrable
                (fun r =>
                  SingularClosure.criticalWeakTransport (g.velocity r)
                    (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff (φ r))))
                MeasureTheory.volume s t
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE
'QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_IDENTITY
@QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_IDENTITY : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (s t : ℝ),
      0 < s →
        s ≤ t →
          SingularClosure.physicalFieldInner (g.velocity t) (φ t) -
              SingularClosure.physicalFieldInner (g.velocity s) (φ s) =
            ∫ (r : ℝ) in s..t,
              SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.timeDerivative φ r) +
                  ν * SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.laplacian (φ r)) +
                SingularClosure.criticalWeakTransport (g.velocity r)
                  (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff (φ r)))
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_IDENTITY
'QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_IDENTITY' depends on axioms: [propext, Classical.choice, Quot.sound]
