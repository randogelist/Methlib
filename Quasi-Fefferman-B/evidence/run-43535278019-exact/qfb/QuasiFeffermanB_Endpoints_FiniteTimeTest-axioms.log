TYPE_BEGIN:QuasiFeffermanB.energyGalerkin_velocity_hasDerivAt
@QuasiFeffermanB.energyGalerkin_velocity_hasDerivAt : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
  0 < t →
    ∀ (x : SingularClosure.Vec), HasDerivAt (fun r => g.velocity r x) (SingularClosure.timeDerivative g.velocity t x) t
