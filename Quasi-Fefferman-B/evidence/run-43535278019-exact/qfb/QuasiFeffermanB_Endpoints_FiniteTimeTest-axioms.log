TYPE_BEGIN:QuasiFeffermanB.energy_finiteSynthesis_joint_continuousOn
QuasiFeffermanB.energy_finiteSynthesis_joint_continuousOn : ∀ (N : ℕ) (c : ℝ → SingularClosure.FourierCoeff)
  (I : Set ℝ),
  (∀ (k : SingularClosure.Frequency) (i : Fin 3), ContinuousOn (fun r => c r k i) I) →
    ContinuousOn (fun z => SingularClosure.finiteSynthesis N (c z.1) z.2) {z | z.1 ∈ I}
TYPE_END:QuasiFeffermanB.energy_finiteSynthesis_joint_continuousOn
'QuasiFeffermanB.energy_finiteSynthesis_joint_continuousOn' depends on axioms: [propext, Classical.choice, Quot.sound]
