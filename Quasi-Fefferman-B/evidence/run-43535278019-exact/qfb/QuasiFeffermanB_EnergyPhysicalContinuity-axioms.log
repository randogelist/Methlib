QuasiFeffermanB.energyH0PhysicalMap_apply : ∀ (U : ℝ → SingularClosure.TorusSobolev 0) (t : ℝ),
  QuasiFeffermanB.energyH0PhysicalMap (U t) = QuasiFeffermanB.energyPhysicalVelocityL2 U t
