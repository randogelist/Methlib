TYPE_BEGIN:QuasiFeffermanB.restartTest_timeDerivative
QuasiFeffermanB.restartTest_timeDerivative : ∀ (s : ℝ) {c r : ℝ},
  0 < c →
    2 * c < r - s →
      0 < r →
        ∀ {φ : SingularClosure.Velocity},
          SingularClosure.CriticalPositiveSolenoidalTest φ →
            SingularClosure.timeDerivative (QuasiFeffermanB.restartTest s c φ) r =
              SingularClosure.timeDerivative φ (r - s)
