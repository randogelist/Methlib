TYPE_BEGIN:QuasiFeffermanB.physical_complex_gradient_annihilation
QuasiFeffermanB.physical_complex_gradient_annihilation : ∀ (v : SingularClosure.Field),
  MeasureTheory.MemLp v 2 (MeasureTheory.volume.restrict SingularClosure.unitCube) →
    (∀ (p : SingularClosure.Vec → ℝ),
        ContDiff ℝ (↑⊤) p →
          SingularClosure.SpatialPeriodic p → SingularClosure.physicalFieldInner v (SingularClosure.gradient p) = 0) →
      ∀ (f : SingularClosure.Vec → ℂ),
        ContDiff ℝ (↑⊤) f →
          SingularClosure.SpatialPeriodic f →
            ∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                ∑ i, ↑((v x).ofLp i) * (fderiv ℝ f x) (SingularClosure.unitVector i) =
              0
TYPE_END:QuasiFeffermanB.physical_complex_gradient_annihilation
'QuasiFeffermanB.physical_complex_gradient_annihilation' depends on axioms: [propext, Classical.choice, Quot.sound]
