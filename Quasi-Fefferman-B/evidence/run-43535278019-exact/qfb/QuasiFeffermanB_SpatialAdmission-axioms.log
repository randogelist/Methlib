TYPE_BEGIN:QuasiFeffermanB.LH_POSITIVE_TRACE_FOURIER_CONSTRAINTS
@QuasiFeffermanB.LH_POSITIVE_TRACE_FOURIER_CONSTRAINTS : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  SingularClosure.CriticalLerayHopf ν a u G →
    QuasiFeffermanB.EnergySigmaZero a →
