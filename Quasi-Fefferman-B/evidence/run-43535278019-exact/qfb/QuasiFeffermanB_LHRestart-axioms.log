TYPE_BEGIN:QuasiFeffermanB.lh_energy_le_from_start
@QuasiFeffermanB.lh_energy_le_from_start : ∀ {ν : ℝ} {v : SingularClosure.Velocity}
  {G : ℝ → SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec},
  0 ≤ ν →
    ∀ {s t : ℝ},
      (∀ (r : ℝ),
          s ≤ r →
            SingularClosure.physicalEnergy (v r) +
                2 * ν * ∫ (q : ℝ) in s..r, SingularClosure.criticalGradientEnergy (G q) ≤
              SingularClosure.physicalEnergy (v s)) →
        s ≤ t → SingularClosure.physicalEnergy (v t) ≤ SingularClosure.physicalEnergy (v s)
TYPE_END:QuasiFeffermanB.lh_energy_le_from_start
