  {v : SingularClosure.Velocity} {G : ℝ → SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec},
  SingularClosure.CriticalLerayHopf ν a₀ v G →
    0 ≤ ν →
      ∀ {s : ℝ},
