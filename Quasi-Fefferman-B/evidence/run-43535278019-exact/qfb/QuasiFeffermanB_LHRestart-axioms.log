@QuasiFeffermanB.strong_tendsto_of_inner_and_norm_bound : ∀ {ι : Type u_1} {E : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] {l : Filter ι} {f : ι → E} {a : E},
  Filter.Tendsto (fun i => inner ℝ (f i) a) l (nhds (‖a‖ ^ 2)) →
    (∀ᶠ (i : ι) in l, ‖f i‖ ^ 2 ≤ ‖a‖ ^ 2) → Filter.Tendsto f l (nhds a)
