TYPE_BEGIN:QuasiFeffermanB.LH_UNIQUE_FUTURE_OF_REFERENCE_SHIFT_SERRIN
@QuasiFeffermanB.LH_UNIQUE_FUTURE_OF_REFERENCE_SHIFT_SERRIN : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  0 < ν →
    SingularClosure.CriticalLerayHopf ν a u G →
      ∀ {v : SingularClosure.Velocity} {p : SingularClosure.Pressure},
        SingularClosure.PositiveSmoothNSE ν v p →
          ∀ {s δ : ℝ},
            0 ≤ s →
              s < δ →
                (∀ (r : ℝ), s < r → u r =ᵐ[MeasureTheory.volume.restrict SingularClosure.unitCube] v (r - s)) →
                  (∀ (T : ℝ),
                      0 < T →
                        MeasureTheory.MemLp
                          (fun t => SingularClosure.criticalSpatialNorm 6 (QuasiFeffermanB.timeTranslate (δ - s) v t)) 4
                          (MeasureTheory.volume.restrict (Set.Ioc 0 T))) →
                    QuasiFeffermanB.UniqueFuture ν u G δ
TYPE_END:QuasiFeffermanB.LH_UNIQUE_FUTURE_OF_REFERENCE_SHIFT_SERRIN
'QuasiFeffermanB.LH_UNIQUE_FUTURE_OF_REFERENCE_SHIFT_SERRIN' depends on axioms: [propext, Classical.choice, Quot.sound]
