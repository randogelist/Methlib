TYPE_BEGIN:QuasiFeffermanB.physicalH1SobolevDatum_half_norm_sq
@QuasiFeffermanB.physicalH1SobolevDatum_half_norm_sq : ∀ {v : SingularClosure.Field}
  {G : SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec}
  (hv : SingularClosure.CriticalPhysicalH1 v G)
  (hz : SingularClosure.SpectralMeanZero (SingularClosure.datumFourierCoeff v)),
  ‖(SingularClosure.criticalSobolevLower 1 2 ⋯) (QuasiFeffermanB.physicalH1SobolevDatum hv hz)‖ ^ 2 =
    (QuasiFeffermanB.physicalHalfEnergy v).toReal
TYPE_END:QuasiFeffermanB.physicalH1SobolevDatum_half_norm_sq
