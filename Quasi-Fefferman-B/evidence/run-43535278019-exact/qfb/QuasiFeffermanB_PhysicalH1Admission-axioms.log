TYPE_BEGIN:QuasiFeffermanB.physicalH1SobolevDatum_physicalL2
@QuasiFeffermanB.physicalH1SobolevDatum_physicalL2 : ∀ {v : SingularClosure.Field}
  {G : SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec}
  (hv : SingularClosure.CriticalPhysicalH1 v G)
  (hz : SingularClosure.SpectralMeanZero (SingularClosure.datumFourierCoeff v)),
  SingularClosure.criticalInitialPhysicalL2
      ((SingularClosure.criticalSobolevLower 1 2 ⋯) (QuasiFeffermanB.physicalH1SobolevDatum hv hz)) =
    SingularClosure.criticalL2Representative v
TYPE_END:QuasiFeffermanB.physicalH1SobolevDatum_physicalL2
'QuasiFeffermanB.physicalH1SobolevDatum_physicalL2' depends on axioms: [propext, Classical.choice, Quot.sound]
