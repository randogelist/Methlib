TYPE_BEGIN:QuasiFeffermanB.meanZero_sobolevCutoff_sum
QuasiFeffermanB.meanZero_sobolevCutoff_sum : ∀ (q N : ℕ) (c : SingularClosure.FourierCoeff),
  SingularClosure.SpectralMeanZero c →
    ∑ ki ∈ SingularClosure.sobolevCutoffIndices N,
        SingularClosure.criticalFrequencyWeight ki.1 ^ q * Complex.normSq (c ki.1 ki.2) =
      SingularClosure.criticalEnergy q N c
TYPE_END:QuasiFeffermanB.meanZero_sobolevCutoff_sum
'QuasiFeffermanB.meanZero_sobolevCutoff_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.physicalH1_weighted_finite_bound
@QuasiFeffermanB.physicalH1_weighted_finite_bound : ∀ {v : SingularClosure.Field}
  {G : SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec},
  SingularClosure.CriticalPhysicalH1 v G →
    SingularClosure.SpectralMeanZero (SingularClosure.datumFourierCoeff v) →
      ∀ (S : Finset SingularClosure.FourierIndex),
        ∑ ki ∈ S, ‖SingularClosure.criticalWeightedCoeff 2 (SingularClosure.datumFourierCoeff v) ki‖ ^ 2 ≤
          SingularClosure.criticalGradientEnergy G
TYPE_END:QuasiFeffermanB.physicalH1_weighted_finite_bound
'QuasiFeffermanB.physicalH1_weighted_finite_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
