TYPE_BEGIN:QuasiFeffermanB.caloric_criticalEnergy_le_succ
QuasiFeffermanB.caloric_criticalEnergy_le_succ : ∀ (q N : ℕ) (c : SingularClosure.FourierCoeff),
  SingularClosure.criticalEnergy q N c ≤ SingularClosure.criticalEnergy (q + 1) N c
TYPE_END:QuasiFeffermanB.caloric_criticalEnergy_le_succ
'QuasiFeffermanB.caloric_criticalEnergy_le_succ' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.caloric_criticalEnergy_four_eq_laplacian
QuasiFeffermanB.caloric_criticalEnergy_four_eq_laplacian : ∀ (N : ℕ) (c : SingularClosure.FourierCoeff),
  SingularClosure.criticalEnergy 4 N c = SingularClosure.coefficientLaplacianSquare N c
TYPE_END:QuasiFeffermanB.caloric_criticalEnergy_four_eq_laplacian
'QuasiFeffermanB.caloric_criticalEnergy_four_eq_laplacian' depends on axioms: [propext, Classical.choice, Quot.sound]
