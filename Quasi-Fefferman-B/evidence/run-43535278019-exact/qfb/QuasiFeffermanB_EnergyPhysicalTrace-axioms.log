TYPE_BEGIN:QuasiFeffermanB.ENERGY_PHYSICAL_STRONG_INITIAL_TRACE
QuasiFeffermanB.ENERGY_PHYSICAL_STRONG_INITIAL_TRACE : ∀ (U : ℝ → SingularClosure.TorusSobolev 0)
  (a : QuasiFeffermanB.EnergyDatum),
  ↑(U 0) = SingularClosure.datumFourierCoeff ↑↑↑a →
    (∀ (t : ℝ), 0 ≤ t → ‖U t‖ ≤ ‖↑a‖) →
      (∀ (k : SingularClosure.Frequency) (i : Fin 3), ContinuousOn (fun t => ↑(U t) k i) (Set.Ici 0)) →
        Filter.Tendsto
          (fun t =>
            MeasureTheory.eLpNorm (QuasiFeffermanB.energyPeriodicVelocity U t - ↑↑↑a) 2
              (MeasureTheory.volume.restrict SingularClosure.unitCube))
          (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
