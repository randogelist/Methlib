  (f : ι → ↥(MeasureTheory.Lp E 2 (MeasureTheory.volume.restrict SingularClosure.unitCube))),
  ↑↑(∑ i ∈ s, f i) =ᵐ[MeasureTheory.volume.restrict SingularClosure.unitCube] fun x => ∑ i ∈ s, ↑↑(f i) x
