TYPE_BEGIN:QuasiFeffermanB.CLASSICAL_TAIL_OF_GLOBAL_SMOOTH_NSE
@QuasiFeffermanB.CLASSICAL_TAIL_OF_GLOBAL_SMOOTH_NSE : ∀ {ν : ℝ} {a : SingularClosure.Field}
  {v : SingularClosure.Velocity} {p : SingularClosure.Pressure},
  SingularClosure.GlobalSmoothNSE ν a v p → ∀ (δ : ℝ), 0 ≤ δ → QuasiFeffermanB.ClassicalTail ν δ v p
TYPE_END:QuasiFeffermanB.CLASSICAL_TAIL_OF_GLOBAL_SMOOTH_NSE
'QuasiFeffermanB.CLASSICAL_TAIL_OF_GLOBAL_SMOOTH_NSE' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.ZERO_LH_HAS_SMOOTH_TAIL
@QuasiFeffermanB.ZERO_LH_HAS_SMOOTH_TAIL : ∀ {ν : ℝ},
  0 ≤ ν →
    ∀ {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
      SingularClosure.CriticalLerayHopf ν 0 u G → ∀ (δ : ℝ), 0 ≤ δ → QuasiFeffermanB.HasSmoothTail ν u δ
TYPE_END:QuasiFeffermanB.ZERO_LH_HAS_SMOOTH_TAIL
'QuasiFeffermanB.ZERO_LH_HAS_SMOOTH_TAIL' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.SAFE_CUTOFF_TAIL
@QuasiFeffermanB.SAFE_CUTOFF_TAIL : ∀ {ν : ℝ},
  0 < ν →
    ∀ {a : ↥SingularClosure.CriticalPhysicalL2} {u : SingularClosure.Velocity}
      {G : QuasiFeffermanB.WeakGradientTrajectory},
      SingularClosure.CriticalLerayHopf ν a u G →
        (∀ (δ : ℝ), QuasiFeffermanB.cutoff a ν < δ → QuasiFeffermanB.HasSmoothTail ν u δ) →
          QuasiFeffermanB.HasSmoothTail ν u (QuasiFeffermanB.safeCutoff a ν)
TYPE_END:QuasiFeffermanB.SAFE_CUTOFF_TAIL
'QuasiFeffermanB.SAFE_CUTOFF_TAIL' depends on axioms: [propext, Classical.choice, Quot.sound]
