TYPE_BEGIN:QuasiFeffermanB.physicalEnergy_eq_toLp_norm_sq
QuasiFeffermanB.physicalEnergy_eq_toLp_norm_sq : ∀ (v : SingularClosure.Field)
  (hv : MeasureTheory.MemLp v 2 (MeasureTheory.volume.restrict SingularClosure.unitCube)),
  SingularClosure.physicalEnergy v = ‖MeasureTheory.MemLp.toLp v hv‖ ^ 2
TYPE_END:QuasiFeffermanB.physicalEnergy_eq_toLp_norm_sq
'QuasiFeffermanB.physicalEnergy_eq_toLp_norm_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.physicalEnergy_tendsto_of_L2
QuasiFeffermanB.physicalEnergy_tendsto_of_L2 : ∀ (f : ℕ → SingularClosure.Field) (v : SingularClosure.Field),
  (∀ (n : ℕ), MeasureTheory.MemLp (f n) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube)) →
    MeasureTheory.MemLp v 2 (MeasureTheory.volume.restrict SingularClosure.unitCube) →
      Filter.Tendsto
          (fun n => MeasureTheory.eLpNorm (f n - v) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube))
          Filter.atTop (nhds 0) →
        Filter.Tendsto (fun n => SingularClosure.physicalEnergy (f n)) Filter.atTop
          (nhds (SingularClosure.physicalEnergy v))
TYPE_END:QuasiFeffermanB.physicalEnergy_tendsto_of_L2
'QuasiFeffermanB.physicalEnergy_tendsto_of_L2' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.physicalEnergy_compCLM_tendsto_of_L2
@QuasiFeffermanB.physicalEnergy_compCLM_tendsto_of_L2 : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] (L : E →L[ℝ] SingularClosure.Vec) (f : ℕ → SingularClosure.Vec → E)
  (g : SingularClosure.Vec → E),
  (∀ (n : ℕ), MeasureTheory.MemLp (f n) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube)) →
    MeasureTheory.MemLp g 2 (MeasureTheory.volume.restrict SingularClosure.unitCube) →
      Filter.Tendsto
          (fun n => MeasureTheory.eLpNorm (f n - g) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube))
          Filter.atTop (nhds 0) →
        Filter.Tendsto (fun n => SingularClosure.physicalEnergy (⇑L ∘ f n)) Filter.atTop
          (nhds (SingularClosure.physicalEnergy (⇑L ∘ g)))
TYPE_END:QuasiFeffermanB.physicalEnergy_compCLM_tendsto_of_L2
'QuasiFeffermanB.physicalEnergy_compCLM_tendsto_of_L2' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.datumFourierCoeff_tendsto_of_L2
QuasiFeffermanB.datumFourierCoeff_tendsto_of_L2 : ∀ (f : ℕ → SingularClosure.Field) (v : SingularClosure.Field),
  (∀ (n : ℕ), MeasureTheory.MemLp (f n) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube)) →
    MeasureTheory.MemLp v 2 (MeasureTheory.volume.restrict SingularClosure.unitCube) →
      Filter.Tendsto
          (fun n => MeasureTheory.eLpNorm (f n - v) 2 (MeasureTheory.volume.restrict SingularClosure.unitCube))
          Filter.atTop (nhds 0) →
        ∀ (k : SingularClosure.Frequency) (i : Fin 3),
          Filter.Tendsto (fun n => SingularClosure.datumFourierCoeff (f n) k i) Filter.atTop
            (nhds (SingularClosure.datumFourierCoeff v k i))
TYPE_END:QuasiFeffermanB.datumFourierCoeff_tendsto_of_L2
'QuasiFeffermanB.datumFourierCoeff_tendsto_of_L2' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.physicalH1_cutoff_bounds
@QuasiFeffermanB.physicalH1_cutoff_bounds : ∀ {v : SingularClosure.Field}
  {G : SingularClosure.Vec → SingularClosure.Vec →L[ℝ] SingularClosure.Vec},
  SingularClosure.CriticalPhysicalH1 v G →
    ∀ (N : ℕ),
      SingularClosure.coefficientEnergy N (SingularClosure.datumFourierCoeff v) ≤ SingularClosure.physicalEnergy v ∧
        SingularClosure.coefficientDissipation N (SingularClosure.datumFourierCoeff v) ≤
          SingularClosure.criticalGradientEnergy G
