TYPE_BEGIN:QuasiFeffermanB.STRICT_CALORIC_QUADRATIC_BUDGET
QuasiFeffermanB.STRICT_CALORIC_QUADRATIC_BUDGET : ∀ (X : ℝ → ℝ) (ν Q T : ℝ),
  0 < ν →
    0 ≤ Q →
      Q ^ 2 < ν ^ 2 / 2 →
        ContinuousOn X (Set.Icc 0 T) →
          X 0 = 0 →
            (∀ t ∈ Set.Icc 0 T, 0 ≤ X t) →
              (∀ t ∈ Set.Icc 0 T,
                  X t ≤ QuasiFeffermanB.caloricHeatBudget ν Q + QuasiFeffermanB.caloricBilinearConstant ν * X t ^ 2) →
                ∀ t ∈ Set.Icc 0 T, X t ^ 2 ≤ 4 * Q ^ 2 / ν
TYPE_END:QuasiFeffermanB.STRICT_CALORIC_QUADRATIC_BUDGET
