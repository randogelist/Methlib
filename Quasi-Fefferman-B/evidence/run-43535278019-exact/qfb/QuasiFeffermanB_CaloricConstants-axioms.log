TYPE_BEGIN:QuasiFeffermanB.STRICT_CALORIC_DISCRIMINANT
QuasiFeffermanB.STRICT_CALORIC_DISCRIMINANT : ∀ (ν Q : ℝ),
  0 < ν →
    0 ≤ Q →
      Q ^ 2 < ν ^ 2 / 2 → 4 * QuasiFeffermanB.caloricBilinearConstant ν * QuasiFeffermanB.caloricHeatBudget ν Q < 1
TYPE_END:QuasiFeffermanB.STRICT_CALORIC_DISCRIMINANT
