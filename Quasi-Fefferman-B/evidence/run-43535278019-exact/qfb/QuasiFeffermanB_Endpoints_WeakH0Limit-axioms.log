TYPE_BEGIN:QuasiFeffermanB.ENERGY_LP_WEAK_TENDSTO
QuasiFeffermanB.ENERGY_LP_WEAK_TENDSTO : ∀ (F : ℕ → ↥SingularClosure.FourierVectorSequence)
  (v : ↥SingularClosure.FourierVectorSequence) (R : ℝ),
  0 ≤ R →
    (∀ (n : ℕ), ‖F n‖ ≤ R) →
      ‖v‖ ≤ R →
        (∀ (ki : SingularClosure.FourierIndex), Filter.Tendsto (fun n => ↑(F n) ki) Filter.atTop (nhds (↑v ki))) →
          ∀ (w : ↥SingularClosure.FourierVectorSequence),
            Filter.Tendsto (fun n => inner ℂ (F n) w) Filter.atTop (nhds (inner ℂ v w))
TYPE_END:QuasiFeffermanB.ENERGY_LP_WEAK_TENDSTO
'QuasiFeffermanB.ENERGY_LP_WEAK_TENDSTO' depends on axioms: [propext, Classical.choice, Quot.sound]
