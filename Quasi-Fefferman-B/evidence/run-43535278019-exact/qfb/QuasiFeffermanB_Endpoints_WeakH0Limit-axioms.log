TYPE_BEGIN:QuasiFeffermanB.energy_galerkin_physical_L2
@QuasiFeffermanB.energy_galerkin_physical_L2 : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N) (r : ℝ),
