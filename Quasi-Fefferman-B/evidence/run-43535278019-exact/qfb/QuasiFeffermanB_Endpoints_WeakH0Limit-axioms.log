TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_PHYSICAL_PAIRING_TENDSTO
QuasiFeffermanB.ENERGY_GALERKIN_PHYSICAL_PAIRING_TENDSTO : ∀ (ν : ℝ),
  0 ≤ ν →
    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (R : ℝ),
      0 ≤ R →
        (∀ (n : ℕ), SingularClosure.coefficientEnergy (N n) ((g n).coeff 0) ≤ R ^ 2) →
          ∀ (U : ℝ → SingularClosure.TorusSobolev 0),
            (∀ (t : ℝ),
                0 ≤ t →
                  ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                    Filter.Tendsto (fun n => (g n).coeff t k i) Filter.atTop (nhds (↑(U t) k i))) →
              ∀ (r : ℝ),
                0 ≤ r →
                  ∀ (φ : SingularClosure.Field),
                    MeasureTheory.MemLp φ 2 (MeasureTheory.volume.restrict SingularClosure.unitCube) →
                      Filter.Tendsto (fun n => SingularClosure.physicalFieldInner ((g n).velocity r) φ) Filter.atTop
                        (nhds (SingularClosure.physicalFieldInner (QuasiFeffermanB.energyPeriodicVelocity U r) φ))
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_PHYSICAL_PAIRING_TENDSTO
'QuasiFeffermanB.ENERGY_GALERKIN_PHYSICAL_PAIRING_TENDSTO' depends on axioms: [propext, Classical.choice, Quot.sound]
