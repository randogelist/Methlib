TYPE_BEGIN:QuasiFeffermanB.criticalFourthPower_integrable
@QuasiFeffermanB.criticalFourthPower_integrable : ∀ {α : Type u_1} [inst : MeasurableSpace α]
  {m : MeasureTheory.Measure α} {kinetic gradient critical : α → ℝ} {M : ℝ},
  MeasureTheory.Integrable gradient m →
    MeasureTheory.AEStronglyMeasurable (fun t => critical t ^ 2) m →
      (∀ᵐ (t : α) ∂m, 0 ≤ gradient t ∧ kinetic t ≤ M ∧ critical t ^ 2 ≤ kinetic t * gradient t) →
        MeasureTheory.Integrable (fun t => critical t ^ 2) m
TYPE_END:QuasiFeffermanB.criticalFourthPower_integrable
'QuasiFeffermanB.criticalFourthPower_integrable' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.criticalFourthPower_budget
@QuasiFeffermanB.criticalFourthPower_budget : ∀ {α : Type u_1} [inst : MeasurableSpace α] {m : MeasureTheory.Measure α}
  {kinetic gradient critical : α → ℝ} {M μ : ℝ},
  0 ≤ M →
    MeasureTheory.Integrable gradient m →
      MeasureTheory.AEStronglyMeasurable (fun t => critical t ^ 2) m →
        (∀ᵐ (t : α) ∂m, 0 ≤ gradient t ∧ kinetic t ≤ M ∧ critical t ^ 2 ≤ kinetic t * gradient t) →
          ∫ (t : α), gradient t ∂m ≤ M / (2 * μ) → ∫ (t : α), critical t ^ 2 ∂m ≤ M ^ 2 / (2 * μ)
TYPE_END:QuasiFeffermanB.criticalFourthPower_budget
'QuasiFeffermanB.criticalFourthPower_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.energyCutoff_nonneg
@QuasiFeffermanB.energyCutoff_nonneg : ∀ {M μ : ℝ}, 0 < μ → 0 ≤ QuasiFeffermanB.energyCutoff M μ
TYPE_END:QuasiFeffermanB.energyCutoff_nonneg
'QuasiFeffermanB.energyCutoff_nonneg' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.LH_HALF_ENERGY_AE_FINITE
@QuasiFeffermanB.LH_HALF_ENERGY_AE_FINITE : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  SingularClosure.CriticalLerayHopf ν a u G →
    ∀ {T : ℝ}, 0 < T → ∀ᵐ (t : ℝ) ∂QuasiFeffermanB.criticalTimeMeasure T, QuasiFeffermanB.physicalHalfEnergy (u t) ≠ ⊤
TYPE_END:QuasiFeffermanB.LH_HALF_ENERGY_AE_FINITE
'QuasiFeffermanB.LH_HALF_ENERGY_AE_FINITE' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.LH_HALF_ENERGY_AEMEASURABLE
@QuasiFeffermanB.LH_HALF_ENERGY_AEMEASURABLE : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  SingularClosure.CriticalLerayHopf ν a u G →
    ∀ {T : ℝ},
      0 < T → AEMeasurable (fun t => QuasiFeffermanB.physicalHalfEnergy (u t)) (QuasiFeffermanB.criticalTimeMeasure T)
TYPE_END:QuasiFeffermanB.LH_HALF_ENERGY_AEMEASURABLE
'QuasiFeffermanB.LH_HALF_ENERGY_AEMEASURABLE' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.LH_FOURTH_POWER_BUDGET
@QuasiFeffermanB.LH_FOURTH_POWER_BUDGET : ∀ {ν : ℝ} {a : ↥SingularClosure.CriticalPhysicalL2}
  {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
  0 < ν →
    SingularClosure.CriticalLerayHopf ν a u G →
      ∀ {T : ℝ},
        0 < T →
          MeasureTheory.Integrable (fun t => (QuasiFeffermanB.physicalHalfEnergy (u t)).toReal ^ 2)
              (QuasiFeffermanB.criticalTimeMeasure T) ∧
            ∫ (t : ℝ), (QuasiFeffermanB.physicalHalfEnergy (u t)).toReal ^ 2 ∂QuasiFeffermanB.criticalTimeMeasure T ≤
              ‖a‖ ^ 4 / (2 * ν)
TYPE_END:QuasiFeffermanB.LH_FOURTH_POWER_BUDGET
'QuasiFeffermanB.LH_FOURTH_POWER_BUDGET' depends on axioms: [propext, Classical.choice, Quot.sound]
