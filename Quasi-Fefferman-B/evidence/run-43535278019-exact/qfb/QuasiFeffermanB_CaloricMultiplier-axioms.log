TYPE_BEGIN:QuasiFeffermanB.complexTransverse_symmetric
QuasiFeffermanB.complexTransverse_symmetric : ∀ (e z w : EuclideanSpace ℂ (Fin 3)),
  QuasiFeffermanB.complexTransverse e (inner ℂ e z • w + inner ℂ e w • z) =
    inner ℂ e z • QuasiFeffermanB.complexTransverse e w + inner ℂ e w • QuasiFeffermanB.complexTransverse e z
TYPE_END:QuasiFeffermanB.complexTransverse_symmetric
