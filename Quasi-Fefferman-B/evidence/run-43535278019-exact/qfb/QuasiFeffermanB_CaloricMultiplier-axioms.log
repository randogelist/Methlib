TYPE_BEGIN:QuasiFeffermanB.complexTransverse_pythagoras
QuasiFeffermanB.complexTransverse_pythagoras : ∀ (e z : EuclideanSpace ℂ (Fin 3)),
  ‖e‖ = 1 → ‖z‖ ^ 2 = ‖inner ℂ e z‖ ^ 2 + ‖QuasiFeffermanB.complexTransverse e z‖ ^ 2
TYPE_END:QuasiFeffermanB.complexTransverse_pythagoras
'QuasiFeffermanB.complexTransverse_pythagoras' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER
QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER : ∀ (e z w : EuclideanSpace ℂ (Fin 3)),
  ‖e‖ = 1 → ‖QuasiFeffermanB.complexTransverse e (inner ℂ e z • w + inner ℂ e w • z)‖ ≤ ‖z‖ * ‖w‖
TYPE_END:QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER
'QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER_SCALED
QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER_SCALED : ∀ (κ : ℝ),
  0 ≤ κ →
    ∀ (e z w : EuclideanSpace ℂ (Fin 3)),
      ‖e‖ = 1 →
        ‖↑(κ / 2) • QuasiFeffermanB.complexTransverse e (inner ℂ e z • w + inner ℂ e w • z)‖ ≤ κ / 2 * (‖z‖ * ‖w‖)
TYPE_END:QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER_SCALED
'QuasiFeffermanB.SYMMETRIC_COMPLEX_LERAY_MULTIPLIER_SCALED' depends on axioms: [propext, Classical.choice, Quot.sound]
