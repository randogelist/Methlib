TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_INTERVAL_LIMIT
QuasiFeffermanB.ENERGY_GALERKIN_INTERVAL_LIMIT : ∀ (ν : ℝ),
  0 < ν →
    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (U : ℝ → SingularClosure.TorusSobolev 0) (W : ℝ → SingularClosure.CriticalSobolev 2) (s t : ℝ),
      0 ≤ s →
        s ≤ t →
          (∀ r ∈ Set.Icc s t,
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                Filter.Tendsto (fun n => (g n).coeff r k i) Filter.atTop (nhds (↑(U r) k i))) →
            MeasureTheory.MemLp W 2 (MeasureTheory.volume.restrict (Set.Icc s t)) →
              (∀ᵐ (r : ℝ) ∂MeasureTheory.volume.restrict (Set.Icc s t),
                  SingularClosure.criticalCoeff 2 (W r) = ↑(U r)) →
                Filter.Tendsto (fun n => SingularClosure.coefficientEnergy (N n) ((g n).coeff s)) Filter.atTop
                    (nhds (‖U s‖ ^ 2)) →
                  ‖U t‖ ^ 2 + 2 * ν * ∫ (r : ℝ) in Set.Icc s t, ‖W r‖ ^ 2 ≤ ‖U s‖ ^ 2
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_INTERVAL_LIMIT
