TYPE_BEGIN:QuasiFeffermanB.ENERGY_TEST_UNIFORM_SOBOLEV_DECAY
QuasiFeffermanB.ENERGY_TEST_UNIFORM_SOBOLEV_DECAY : ∀ (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (m : ℕ) (s t : ℝ),
      0 < s →
        ∃ C,
          0 ≤ C ∧
            ∀ r ∈ Set.Icc s t,
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                SingularClosure.torusSobolevWeight k ^ (m + 2) * ‖SingularClosure.datumFourierCoeff (φ r) k i‖ ≤ C
