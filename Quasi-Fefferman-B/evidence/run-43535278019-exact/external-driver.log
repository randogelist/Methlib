    "QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE": {
      "type": "@QuasiFeffermanB.ENERGY_GALERKIN_TIME_TEST_INTEGRABLE : \u2200 {\u03bd : \u211d} {a : SingularClosure.Field} {N : \u2115}\n  (g : SingularClosure.GalerkinSolution \u03bd a N) (\u03c6 : SingularClosure.Velocity),\n  SingularClosure.CriticalPositiveSolenoidalTest \u03c6 \u2192\n    \u2200 (s t : \u211d),\n      0 < s \u2192\n        s \u2264 t \u2192\n          IntervalIntegrable\n              (fun r => SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.timeDerivative \u03c6 r))\n              MeasureTheory.volume s t \u2227\n            IntervalIntegrable\n                (fun r => SingularClosure.physicalFieldInner (g.velocity r) (SingularClosure.laplacian (\u03c6 r)))\n                MeasureTheory.volume s t \u2227\n              IntervalIntegrable\n                (fun r =>\n                  SingularClosure.criticalWeakTransport (g.velocity r)\n                    (SingularClosure.finiteSynthesis N (SingularClosure.datumFourierCoeff (\u03c6 r))))\n                MeasureTheory.volume s t",
