TYPE_BEGIN:QuasiFeffermanB.FINITE_CALORIC_UNIFORM_BUDGET
QuasiFeffermanB.FINITE_CALORIC_UNIFORM_BUDGET : ∀ (ν H : ℝ),
  0 < ν →
    0 ≤ H →
      4 * (1 / (2 * √(2 * ν))) * H < 1 →
        ∀ (A : ℝ → ℝ),
          ContinuousOn A (Set.Ici 0) →
            (∀ (T : ℝ),
                0 ≤ T →
                  QuasiFeffermanB.finiteTimeL2 T A ≤ H + 1 / (2 * √(2 * ν)) * QuasiFeffermanB.finiteTimeL2 T A ^ 2) →
              ∀ (T : ℝ), 0 ≤ T → ∫ (t : ℝ) in 0..T, A t ^ 2 ≤ 4 * H ^ 2
TYPE_END:QuasiFeffermanB.FINITE_CALORIC_UNIFORM_BUDGET
