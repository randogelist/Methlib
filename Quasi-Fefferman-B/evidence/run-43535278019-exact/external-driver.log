TYPE_BEGIN:QuasiFeffermanB.energy_coefficient_curve_precompact
QuasiFeffermanB.energy_coefficient_curve_precompact : ∀ (ν : ℝ),
  0 ≤ ν →
    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (R : ℝ),
      0 ≤ R →
        (∀ (n : ℕ), SingularClosure.coefficientEnergy (N n) ((g n).coeff 0) ≤ R ^ 2) →
          ∀ (m : ℕ) (ki : SingularClosure.FourierIndex),
            IsCompact
              (closure
                (Set.range fun n =>
                  BoundedContinuousFunction.mkOfCompact (QuasiFeffermanB.energyCoefficientCurve (g n) m ki)))
