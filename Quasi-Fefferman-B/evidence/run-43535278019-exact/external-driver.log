    ∀ (j : Fin 3) (m : ℕ),
      ContDiffOn ℝ (↑⊤) (fun z => SingularClosure.iteratedCoordinateDerivative j m (φ z.1) z.2) {z | 0 < z.1}
TYPE_END:QuasiFeffermanB.energy_positive_iteratedDerivative_smooth
