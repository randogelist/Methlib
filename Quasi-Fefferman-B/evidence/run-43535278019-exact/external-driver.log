TYPE_BEGIN:QuasiFeffermanB.GALERKIN_CRITICAL_RHS_SQUARE_OF_ENSTROPHY_BOUND
@QuasiFeffermanB.GALERKIN_CRITICAL_RHS_SQUARE_OF_ENSTROPHY_BOUND : ∀ {ν : ℝ},
  0 ≤ ν →
    ∀ {a : SingularClosure.Field} {N : ℕ} (g : SingularClosure.GalerkinSolution ν a N) (L : ℝ),
      0 ≤ L →
        ∀ (t : ℝ),
          0 ≤ t →
            SingularClosure.coefficientDissipation N (g.coeff t) ≤ L →
              ‖g.criticalRhs (-1) t‖ ^ 2 ≤
                (ν + SingularClosure.criticalTransportConstant * (L + 1)) ^ 2 *
                  SingularClosure.criticalEnergy 3 N (g.coeff t)
TYPE_END:QuasiFeffermanB.GALERKIN_CRITICAL_RHS_SQUARE_OF_ENSTROPHY_BOUND
