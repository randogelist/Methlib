@QuasiFeffermanB.GALERKIN_COMPLEX_MODE_HAS_DERIV : ∀ {ν : ℝ} {a : SingularClosure.Field} {N : ℕ}
  (g : SingularClosure.GalerkinSolution ν a N),
  ∀ k ∈ SingularClosure.cutoffModes N,
    ∀ (t : ℝ),
      0 < t →
        HasDerivAt (fun r => QuasiFeffermanB.complexVec (g.coeff r k))
          (QuasiFeffermanB.complexVec (SingularClosure.galerkinRhs ν N (g.coeff t) k)) t
