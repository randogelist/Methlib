TYPE_BEGIN:QuasiFeffermanB.galerkin_energy_coefficient_modulus
@QuasiFeffermanB.galerkin_energy_coefficient_modulus : ∀ {ν : ℝ},
  0 ≤ ν →
    ∀ {a : SingularClosure.Field} {N : ℕ} (g : SingularClosure.GalerkinSolution ν a N) (R T : ℝ),
      0 ≤ R →
        0 ≤ T →
          SingularClosure.coefficientEnergy N (g.coeff 0) ≤ R ^ 2 →
            ∀ (k : SingularClosure.Frequency) (i : Fin 3) {s t : ℝ},
              0 ≤ s →
                s ≤ t →
                  t ≤ T →
                    ‖g.coeff t k i - g.coeff s k i‖ ^ 2 ≤ T * QuasiFeffermanB.energyModeRhsBound ν R k i ^ 2 * (t - s)
TYPE_END:QuasiFeffermanB.galerkin_energy_coefficient_modulus
'QuasiFeffermanB.galerkin_energy_coefficient_modulus' depends on axioms: [propext, Classical.choice, Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_COEFFICIENT_SUBSEQUENCE
QuasiFeffermanB.ENERGY_GALERKIN_COEFFICIENT_SUBSEQUENCE : ∀ (ν : ℝ),
  0 ≤ ν →
    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (R T : ℝ),
      0 ≤ R →
        0 ≤ T →
          (∀ (n : ℕ), SingularClosure.coefficientEnergy (N n) ((g n).coeff 0) ≤ R ^ 2) →
            ∃ u φ,
              StrictMono φ ∧
                ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                  TendstoUniformly (fun n t => (g (φ n)).coeff (↑t) k i) (⇑(u (k, i))) Filter.atTop
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_COEFFICIENT_SUBSEQUENCE
'QuasiFeffermanB.ENERGY_GALERKIN_COEFFICIENT_SUBSEQUENCE' depends on axioms: [propext, Classical.choice, Quot.sound]
