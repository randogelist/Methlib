TYPE_BEGIN:QuasiFeffermanB.ENERGY_GALERKIN_GLOBAL_COEFFICIENT_SUBSEQUENCE
QuasiFeffermanB.ENERGY_GALERKIN_GLOBAL_COEFFICIENT_SUBSEQUENCE : ∀ (ν : ℝ),
  0 ≤ ν →
    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (R : ℝ),
      0 ≤ R →
        (∀ (n : ℕ), SingularClosure.coefficientEnergy (N n) ((g n).coeff 0) ≤ R ^ 2) →
          ∃ u φ,
            StrictMono φ ∧
              (∀ (m : ℕ) (ki : SingularClosure.FourierIndex),
                  TendstoUniformly (fun n t => (g (φ n)).coeff (↑t) ki.1 ki.2) (⇑(u m ki)) Filter.atTop) ∧
                ∀ (m l : ℕ) (ki : SingularClosure.FourierIndex) (t : ℝ) (hm : t ∈ QuasiFeffermanB.EnergyTimeHorizon m)
                  (hl : t ∈ QuasiFeffermanB.EnergyTimeHorizon l), (u m ki) ⟨t, hm⟩ = (u l ki) ⟨t, hl⟩
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_GLOBAL_COEFFICIENT_SUBSEQUENCE
