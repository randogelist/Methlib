  (F : ℕ → ℝ → SingularClosure.CriticalSobolev q) (W : ℝ → SingularClosure.CriticalSobolev q) (B : ℝ),
  (∀ (n : ℕ), MeasureTheory.AEStronglyMeasurable (F n) μ) →
    (∀ᵐ (t : ℝ) ∂μ,
        ∀ (k : SingularClosure.Frequency) (i : Fin 3),
          Filter.Tendsto (fun n => SingularClosure.criticalCoeff q (F n t) k i) Filter.atTop
            (nhds (SingularClosure.criticalCoeff q (W t) k i))) →
      (∀ᶠ (n : ℕ) in Filter.atTop, ∫⁻ (t : ℝ), ENNReal.ofReal (‖F n t‖ ^ 2) ∂μ ≤ ENNReal.ofReal B) →
        ∫⁻ (t : ℝ), ENNReal.ofReal (‖W t‖ ^ 2) ∂μ ≤ ENNReal.ofReal B
TYPE_END:QuasiFeffermanB.energy_modal_lintegral_le_of_eventual_budget
