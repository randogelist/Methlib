TYPE_BEGIN:QuasiFeffermanB.criticalFourthPower_integrable
@QuasiFeffermanB.criticalFourthPower_integrable : ∀ {α : Type u_1} [inst : MeasurableSpace α]
  {m : MeasureTheory.Measure α} {kinetic gradient critical : α → ℝ} {M : ℝ},
  MeasureTheory.Integrable gradient m →
    MeasureTheory.AEStronglyMeasurable (fun t => critical t ^ 2) m →
      (∀ᵐ (t : α) ∂m, 0 ≤ gradient t ∧ kinetic t ≤ M ∧ critical t ^ 2 ≤ kinetic t * gradient t) →
        MeasureTheory.Integrable (fun t => critical t ^ 2) m
TYPE_END:QuasiFeffermanB.criticalFourthPower_integrable
