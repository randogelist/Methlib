                    (∀ᵐ (t : ℝ) ∂MeasureTheory.volume.restrict (Set.Icc 0 T),
                        SingularClosure.criticalCoeff 2 (W t) = ↑(U t)) ∧
                      ∫ (t : ℝ) in Set.Icc 0 T, ‖W t‖ ^ 2 ≤ R ^ 2 / (2 * ν)
