 Classical.choice,
 Quot.sound]
TYPE_BEGIN:QuasiFeffermanB.GALERKIN_CRITICAL_COMPACTNESS_OF_ENSTROPHY
QuasiFeffermanB.GALERKIN_CRITICAL_COMPACTNESS_OF_ENSTROPHY : ∀ (ν : ℝ),
  0 < ν →
    ∀ (a : SingularClosure.CriticalSobolev 1),
      SingularClosure.SpectralReality (SingularClosure.criticalCoeff 1 a) →
        SingularClosure.SpectralMeanZero (SingularClosure.criticalCoeff 1 a) →
          ∀
            (g :
              (n : ℕ) →
                SingularClosure.GalerkinSolution ν
                  (SingularClosure.finiteSynthesis (n + 1) (SingularClosure.criticalCoeff 1 a)) (n + 1))
            (L : ℝ),
            0 ≤ L →
              (∀ (n : ℕ) (t : ℝ), 0 ≤ t → SingularClosure.coefficientDissipation (n + 1) ((g n).coeff t) ≤ L) →
                (∀ (n : ℕ) (T : ℝ),
                    0 ≤ T →
                      ∫ (t : ℝ) in 0..T, SingularClosure.coefficientLaplacianSquare (n + 1) ((g n).coeff t) ≤ L / ν) →
                  ∃ u φ,
                    StrictMono φ ∧
                      ContinuousOn u (Set.Ici 0) ∧
                        u 0 = a ∧
                          (∀ (t : ℝ), 0 ≤ t → ‖u t‖ ≤ L + 1) ∧
                            ∀ (T : ℝ),
                              TendstoUniformlyOn (fun n t => (g (φ n)).sobolevState 0 t)
                                (fun t => (SingularClosure.criticalToTorusH0 1 ⋯) (u t)) Filter.atTop (Set.Icc 0 T)
TYPE_END:QuasiFeffermanB.GALERKIN_CRITICAL_COMPACTNESS_OF_ENSTROPHY
'QuasiFeffermanB.GALERKIN_CRITICAL_COMPACTNESS_OF_ENSTROPHY' depends on axioms: [propext, Classical.choice, Quot.sound]
