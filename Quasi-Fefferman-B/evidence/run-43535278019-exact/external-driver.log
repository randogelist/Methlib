QuasiFeffermanB.ENERGY_TEST_UNIFORM_DERIVATIVE_MAJORANT : ∀ (φ : SingularClosure.Velocity),
  SingularClosure.CriticalPositiveSolenoidalTest φ →
    ∀ (s t : ℝ),
      0 < s →
        ∃ C,
          0 ≤ C ∧
            (Summable fun k => C * (SingularClosure.torusSobolevWeight k)⁻¹ ^ 4) ∧
              ∀ r ∈ Set.Icc s t,
                ∀ (j : Fin 3) (k : SingularClosure.Frequency) (i : Fin 3),
                  ‖SingularClosure.derivativeSymbol j k * SingularClosure.datumFourierCoeff (φ r) k i‖ ≤
                    C * (SingularClosure.torusSobolevWeight k)⁻¹ ^ 4
TYPE_END:QuasiFeffermanB.ENERGY_TEST_UNIFORM_DERIVATIVE_MAJORANT
