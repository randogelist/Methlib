    ∀ (a : ℕ → SingularClosure.Field) (N : ℕ → ℕ) (g : (n : ℕ) → SingularClosure.GalerkinSolution ν (a n) (N n))
      (R T : ℝ),
      0 ≤ R →
        0 ≤ T →
          (∀ (n : ℕ), SingularClosure.coefficientEnergy (N n) ((g n).coeff 0) ≤ R ^ 2) →
            ∃ u v φ,
              StrictMono φ ∧
                (∀ (t : ↑(Set.Icc 0 T)), ‖u t‖ ≤ R) ∧
                  (∀ (k : SingularClosure.Frequency) (i : Fin 3),
                      TendstoUniformly (fun n t => ↑((g (φ n)).sobolevState 0 ↑t) k i) (fun t => ↑(u t) k i)
                        Filter.atTop) ∧
                    Filter.Tendsto (fun n => (g (φ n)).energyTimeH0L2 T) Filter.atTop (nhds v)
TYPE_END:QuasiFeffermanB.ENERGY_GALERKIN_L2H0_SUBSEQUENCE
