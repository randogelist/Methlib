import Tail16Admission.Semantics
import RH_HilbertLimit.ZeroBudgetFirstMoment

set_option autoImplicit false

namespace Tail16Admission

/--
Fixed primitive registry.

The payload chooses a fixed constructor. Cancellation constructors take
one finite expression parameter; moment constructors have no payload.
It cannot supply a theorem name, a replacement conclusion, or a proof premise.
-/
inductive ActualPrimitive where
  | cancellationIdentity : NExpr → ActualPrimitive
  | cancellationNonnegative : NExpr → ActualPrimitive
  | momentZero : ActualPrimitive
  | momentOneLower : ActualPrimitive
  | momentOneUpper : ActualPrimitive
deriving Repr, DecidableEq

namespace ActualPrimitive

def wellScoped (k : Nat) : ActualPrimitive → Bool
  | .cancellationIdentity t =>
      t.wellScoped k
  | .cancellationNonnegative t =>
      t.wellScoped k
  | .momentZero => true
  | .momentOneLower => true
  | .momentOneUpper => true

/--
Fixed conclusion generated by the opcode.

cancellationIdentity(t):
  C(t) = (t+1) * (V(t+1) - V(t))

cancellationNonnegative(t):
  0 <= C(t)

momentZero: u(0) = 1
momentOneLower: 0 <= u(1)
momentOneUpper: u(1) <= 1
-/
def conclusion : ActualPrimitive → Formula
  | .cancellationIdentity t =>
      .rEq
        (.C t)
        (.mul
          (.natCast (.succ t))
          (.add (.V (.succ t)) (.neg (.V t))))
  | .cancellationNonnegative t =>
      .rLe
        (.rat 0 1)
        (.C t)
  | .momentZero =>
      .rEq (.u (.lit 0)) (.rat 1 1)
  | .momentOneLower =>
      .rLe (.rat 0 1) (.u (.lit 1))
  | .momentOneUpper =>
      .rLe (.u (.lit 1)) (.rat 1 1)

def check (k : Nat) (p : ActualPrimitive) : Bool :=
  p.wellScoped k

end ActualPrimitive

theorem actualPrimitive_sound
    {k : Nat}
    (p : ActualPrimitive)
    (hcheck : p.check k = true) :
    ∀ ρ : List Nat,
      ρ.length = k →
      Holds ρ p.conclusion := by
  intro ρ hρ
  cases p with
  | cancellationIdentity t =>
      have ht : t.wellScoped k = true := by
        simpa [ActualPrimitive.check, ActualPrimitive.wellScoped] using hcheck
      simpa [
        ActualPrimitive.conclusion,
        Holds,
        denoteR,
        denoteN,
        RH_HilbertLimit.actualVariation,
        sub_eq_add_neg,
        Nat.cast_add,
        Nat.cast_one
      ] using
        (RH_HilbertLimit.rowCancellation_eq
          RH_HilbertLimit.actualNormalizedMoment
          (denoteN ρ t))
  | cancellationNonnegative t =>
      have ht : t.wellScoped k = true := by
        simpa [ActualPrimitive.check, ActualPrimitive.wellScoped] using hcheck
      simpa [
        ActualPrimitive.conclusion,
        Holds,
        denoteR
      ] using
        (RH_HilbertLimit.rowCancellation_nonneg
          RH_HilbertLimit.actualNormalizedMoment
          (denoteN ρ t))
  | momentZero =>
      simpa [ActualPrimitive.conclusion, Holds, denoteR, denoteN] using
        RH_HilbertLimit.actualNormalizedMoment_zero_unconditional
  | momentOneLower =>
      simpa [ActualPrimitive.conclusion, Holds, denoteR, denoteN] using
        RH_HilbertLimit.actualNormalizedMoment_one_nonneg
  | momentOneUpper =>
      simpa [ActualPrimitive.conclusion, Holds, denoteR, denoteN] using
        RH_HilbertLimit.actualNormalizedMoment_one_le_one

/-- Closed-index positive control for the exact cancellation identity. -/
def cancellationIdentityAt (n : Nat) : ActualPrimitive :=
  .cancellationIdentity (.lit n)

/-- Closed-index positive control for cancellation nonnegativity. -/
def cancellationNonnegativeAt (n : Nat) : ActualPrimitive :=
  .cancellationNonnegative (.lit n)

theorem cancellationIdentityAt_check (n : Nat) :
    (cancellationIdentityAt n).check 0 = true := by
  rfl

theorem cancellationNonnegativeAt_check (n : Nat) :
    (cancellationNonnegativeAt n).check 0 = true := by
  rfl

theorem cancellationIdentityAt_valid (n : Nat) :
    Holds [] (cancellationIdentityAt n).conclusion := by
  exact actualPrimitive_sound
    (cancellationIdentityAt n)
    (cancellationIdentityAt_check n)
    []
    rfl

theorem cancellationNonnegativeAt_valid (n : Nat) :
    Holds [] (cancellationNonnegativeAt n).conclusion := by
  exact actualPrimitive_sound
    (cancellationNonnegativeAt n)
    (cancellationNonnegativeAt_check n)
    []
    rfl

#check ActualPrimitive
#check ActualPrimitive.check
#check ActualPrimitive.conclusion
#check actualPrimitive_sound
#check cancellationIdentityAt_valid
#check cancellationNonnegativeAt_valid
#check RH_HilbertLimit.rowCancellation_eq
#check RH_HilbertLimit.rowCancellation_nonneg

#print axioms Tail16Admission.actualPrimitive_sound
#print axioms Tail16Admission.cancellationIdentityAt_valid
#print axioms Tail16Admission.cancellationNonnegativeAt_valid

end Tail16Admission
