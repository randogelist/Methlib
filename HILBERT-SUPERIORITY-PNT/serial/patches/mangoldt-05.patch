-    simpa [zetaPoint] using hsigma
-  · exact prime_lseries_summable sigma t hsigma
+    LSeriesSummable higherCoefficientC (zetaPoint sigma t) :=
+  (higher_lseries_hasSum sigma t hsigma).summable
 
